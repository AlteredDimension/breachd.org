---
const { path = "/" } = Astro.props;
// Layout per breachd.org_page_selector.excalidraw: an "L" anchored at the
// top-right corner — top bar (home · about · blog) + right vertical bar
// (portfolio · proof · contact). Web title sits top-left.
const topLinks = [
  { href: "/", label: "home" },
  { href: "/about", label: "about" },
  { href: "/blog", label: "blog" },
];
const rightLinks = [
  { href: "/portfolio", label: "portfolio" },
  { href: "/proof", label: "proof" },
  { href: "/contact", label: "contact" },
];
const allLinks = [...topLinks, ...rightLinks];
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="nav">
  <a class="wordmark" href="/" data-wordmark aria-label="breach:d home">
    breach<span class="colon">:</span><span class="d">d</span>
  </a>

  <!-- TOP bar: bold at the right (corner), fades to the left -->
  <nav class="bar bar-top" aria-label="Primary">
    {
      topLinks.map((l) => (
        <a class:list={["link", { active: isActive(l.href) }]} href={l.href}
          aria-current={isActive(l.href) ? "page" : undefined}>
          <span class="label">{l.label}</span>
          <span class="ind" aria-hidden="true" />
        </a>
      ))
    }
  </nav>

  <!-- RIGHT bar: bold at the top (corner), fades downward -->
  <nav class="bar bar-right" aria-label="Secondary">
    {
      rightLinks.map((l) => (
        <a class:list={["link", { active: isActive(l.href) }]} href={l.href}
          aria-current={isActive(l.href) ? "page" : undefined}>
          <span class="label">{l.label}</span>
          <span class="ind" aria-hidden="true" />
        </a>
      ))
    }
  </nav>

  <button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false">
    <span></span><span></span>
  </button>
  <nav class="drawer" aria-label="Mobile">
    {
      allLinks.map((l) => (
        <a class:list={["link", { active: isActive(l.href) }]} href={l.href}>
          {l.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const toggle = document.querySelector(".menu-toggle");
  const nav = document.querySelector(".nav");
  toggle?.addEventListener("click", () => {
    const open = nav?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(!!open));
  });
</script>

<style>
  .nav {
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none; /* only children are interactive */
  }
  .nav > * { pointer-events: auto; }

  .wordmark {
    position: fixed;
    top: 22px;
    left: clamp(20px, 5vw, 56px);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: -0.02em;
    color: var(--text);
    user-select: none;
  }
  .wordmark .colon {
    color: var(--c-accent);
    text-shadow: var(--glow-accent);
    animation: pulse 3.4s var(--ease) infinite;
  }
  .wordmark .d { color: var(--c-primary); }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }

  /* shared frosted bar — blur fades out away from the top-right corner */
  .bar {
    position: fixed;
    display: flex;
    background: linear-gradient(var(--g, to left), rgba(21, 15, 31, 0.66), rgba(21, 15, 31, 0));
    backdrop-filter: blur(13px);
    -webkit-backdrop-filter: blur(13px);
  }
  .bar-top {
    top: 0;
    right: 0;
    flex-direction: row;
    gap: clamp(1.4rem, 3vw, 2.8rem);
    align-items: flex-end;
    height: var(--nav-h);
    padding: 0 clamp(20px, 5vw, 56px) 0 3.5rem;
    /* bold at right corner, fade left */
    -webkit-mask-image: linear-gradient(to left, #000 62%, transparent);
    mask-image: linear-gradient(to left, #000 62%, transparent);
  }
  .bar-right {
    --g: to top;
    top: var(--nav-h);
    right: 0;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-end;
    padding: 1.6rem clamp(20px, 5vw, 56px) 3.5rem;
    /* bold at top corner, fade down */
    -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent);
    mask-image: linear-gradient(to bottom, #000 60%, transparent);
  }

  .link {
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-dim);
    padding-bottom: 0.7rem; /* room for the bottom indicator */
    transition: color 0.25s var(--ease);
  }
  .bar-top .link { padding-bottom: 0.55rem; }

  /* highlight indicator now sits at the BOTTOM of each word */
  .ind {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--c-primary), rgba(200, 156, 251, 0.35) 70%, transparent);
    transform: scaleX(0.45);
    transform-origin: left;
    opacity: 0.5;
    transition: transform 0.4s var(--ease), opacity 0.3s var(--ease), filter 0.3s var(--ease);
  }
  .link:hover .ind,
  .link.active .ind {
    transform: scaleX(1);
    opacity: 1;
    filter: drop-shadow(0 0 6px rgba(200, 156, 251, 0.6));
  }
  .link:hover { color: var(--text); }
  .link.active { color: var(--c-accent); }

  /* mobile */
  .menu-toggle {
    display: none;
    position: fixed;
    top: 20px;
    right: clamp(20px, 5vw, 56px);
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 8px;
  }
  .menu-toggle span { width: 26px; height: 2px; background: var(--c-primary); }
  .drawer { display: none; }

  @media (max-width: 880px) {
    .bar-top, .bar-right { display: none; }
    .menu-toggle { display: flex; }
    .drawer {
      display: flex;
      position: fixed;
      inset: var(--nav-h) 0 auto 0;
      flex-direction: column;
      padding: 1rem clamp(20px, 5vw, 56px) 1.6rem;
      background: rgba(21, 15, 31, 0.96);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid var(--line);
      transform: translateY(-12px);
      opacity: 0;
      pointer-events: none;
      transition: all 0.3s var(--ease);
    }
    .nav.open .drawer { transform: none; opacity: 1; pointer-events: auto; }
    .drawer .link {
      padding: 1rem 0;
      font-size: 0.95rem;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
