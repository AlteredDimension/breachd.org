---
const { path = "/" } = Astro.props;
const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/portfolio", label: "Portfolio" },
  { href: "/blog", label: "Blog" },
  { href: "/proof", label: "Proof" },
  { href: "/contact", label: "Contact" },
];
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="nav">
  <div class="nav-inner shell">
    <a class="wordmark" href="/" data-wordmark aria-label="breach:d home">
      breach<span class="colon">:</span><span class="d">d</span>
    </a>

    <nav class="links" aria-label="Primary">
      {
        links.map((l) => (
          <a
            class:list={["link", { active: isActive(l.href) }]}
            href={l.href}
            aria-current={isActive(l.href) ? "page" : undefined}
          >
            <span class="sep" aria-hidden="true" />
            <span class="label">{l.label}</span>
          </a>
        ))
      }
    </nav>

    <button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span>
    </button>
  </div>
</header>

<script>
  // mobile drawer toggle
  const toggle = document.querySelector(".menu-toggle");
  const nav = document.querySelector(".nav");
  toggle?.addEventListener("click", () => {
    const open = nav?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(!!open));
  });
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    backdrop-filter: blur(14px);
    background: linear-gradient(180deg, rgba(21, 15, 31, 0.72), rgba(21, 15, 31, 0));
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    width: 100%;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: -0.02em;
    color: var(--text);
    user-select: none;
  }
  .wordmark .colon {
    color: var(--c-accent);
    text-shadow: var(--glow-accent);
    animation: pulse 3.4s var(--ease) infinite;
  }
  .wordmark .d {
    color: var(--c-primary);
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .links {
    display: flex;
    gap: clamp(1rem, 2.4vw, 2.4rem);
  }

  /* each link: a separator line that is BOLD at its origin and fades out */
  .link {
    position: relative;
    padding-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .sep {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    /* bold from origin (left), fading to nothing */
    background: linear-gradient(
      90deg,
      var(--c-primary) 0%,
      rgba(200, 156, 251, 0.45) 24%,
      transparent 92%
    );
    transform: scaleX(0.6);
    transform-origin: left;
    opacity: 0.5;
    transition: transform 0.45s var(--ease), opacity 0.3s var(--ease), filter 0.3s var(--ease);
  }
  .link:hover .sep,
  .link.active .sep {
    transform: scaleX(1);
    opacity: 1;
    filter: drop-shadow(0 0 6px rgba(200, 156, 251, 0.6));
  }
  .link:hover,
  .link.active {
    color: var(--text);
  }
  .link.active .label {
    color: var(--c-accent);
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 8px;
  }
  .menu-toggle span {
    width: 26px;
    height: 2px;
    background: var(--c-primary);
    transition: transform 0.3s var(--ease);
  }

  @media (max-width: 820px) {
    .menu-toggle {
      display: flex;
    }
    .links {
      position: fixed;
      inset: var(--nav-h) 0 auto 0;
      flex-direction: column;
      gap: 0;
      padding: 1rem clamp(20px, 5vw, 56px) 1.6rem;
      background: rgba(21, 15, 31, 0.96);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid var(--line);
      transform: translateY(-12px);
      opacity: 0;
      pointer-events: none;
      transition: all 0.3s var(--ease);
    }
    .nav.open .links {
      transform: none;
      opacity: 1;
      pointer-events: auto;
    }
    .link {
      padding: 1rem 0;
      font-size: 0.95rem;
    }
    .sep {
      transform: scaleX(1);
      opacity: 0.6;
    }
  }
</style>
