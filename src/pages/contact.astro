---
import Layout from "../layouts/Layout.astro";
import EyeForm from "../components/react/EyeForm.jsx";
---

<Layout title="contact — breach:d" description="Send a signal. I'm watching.">
  <section class="page shell contact">
    <div class="intro-col">
      <p class="eyebrow">// open a channel</p>
      <h1 class="page-title">Contact</h1>
      <p class="sub">
        Say something interesting. The eyes follow your cursor — and so do I.
      </p>
      <p class="note">// no backend is wired yet — this is a working scaffold.</p>
    </div>
    <EyeForm client:visible />
  </section>
</Layout>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .sub {
    color: var(--text-dim);
    max-width: 36ch;
  }
  .note {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-faint);
    letter-spacing: 0.08em;
  }
  @media (max-width: 820px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
