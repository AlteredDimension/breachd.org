---
import Layout from "../layouts/Layout.astro";
import Eyes from "../components/react/Eyes.jsx";
---

<Layout title="contact — breach:d" description="Send a signal. I'm watching.">
  <section class="page shell contact">
    <div class="intro-col">
      <p class="eyebrow">// open a channel</p>
      <h1 class="page-title">Contact</h1>
      <p class="sub">
        Say something interesting. The eyes follow your cursor — and so do I.
      </p>
      <Eyes client:visible />
    </div>

    <div class="form-col">
      <p class="email-cta">
        Shoot me an email: <a href="mailto:alt@breachd.org">alt@breachd.org</a>
      </p>
    </div>
  </section>
</Layout>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .intro-col {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }
  .sub {
    color: var(--text-dim);
    max-width: 36ch;
    margin: 0;
  }
  .email-cta {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    color: var(--text-dim);
    margin: 0;
  }
  .email-cta a {
    color: var(--c-accent);
  }
  /* stagger: the form sits ~50% lower than the intro block */
  .form-col {
    margin-top: 22vh;
  }
  @media (max-width: 820px) {
    .contact {
      grid-template-columns: 1fr;
    }
    .form-col {
      margin-top: 0;
    }
  }
</style>
