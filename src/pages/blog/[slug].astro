---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { TAGS } from "../../data/tags.js";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  // The collection entry id is the markdown file name (minus .md), which is
  // the post's slug — /blog/<file-name> — so URLs track file names exactly.
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toISOString().slice(0, 10);
const accent = TAGS[post.data.tags[0]] || "#c89cfb";
---

<Layout title={`${post.data.title} — breach:d`} description={post.data.excerpt}>
  <article class="page shell post">
    <a class="back" href="/blog">← back to the feed</a>
    <div class="post-tags">
      {post.data.tags.map((t) => <span style={`color:${TAGS[t]}`}>#{t}</span>)}
    </div>
    <h1 class="post-title" style={`--accent:${accent}`}>{post.data.title}</h1>
    <time datetime={date}>{date}</time>
    {post.data.draft && <p class="placeholder">This is a placeholder draft — real copy coming.</p>}
    <div class="prose">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .post {
    max-width: 760px;
  }
  .back {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
  }
  .post-tags {
    display: flex;
    gap: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    margin: 1.6rem 0 0.6rem;
  }
  .post-title {
    font-size: clamp(2rem, 6vw, 3.6rem);
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    margin: 0.4rem 0;
  }
  time {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-faint);
    letter-spacing: 0.1em;
  }
  .prose {
    margin-top: 2.4rem;
  }
  /* <Content /> renders markdown HTML that doesn't carry Astro's scoping
     attributes, so its elements are styled via :global(). */
  .prose :global(p) {
    font-size: 1.08rem;
    line-height: 1.8;
    margin-bottom: 1.6rem;
    color: var(--text-dim);
  }
  .prose :global(a) {
    text-decoration: underline;
  }
  .prose :global(h2),
  .prose :global(h3) {
    margin-top: 2.2rem;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: color-mix(in srgb, var(--bg-lighter) 35%, transparent);
    border-radius: 6px;
    padding: 0.1em 0.4em;
  }
  .prose :global(pre) {
    padding: 1rem 1.2rem;
    border-radius: 12px;
    border: 1px solid var(--line);
    overflow-x: auto;
  }
  .prose :global(blockquote) {
    margin: 1.6rem 0;
    padding-left: 1rem;
    border-left: 3px solid var(--accent, var(--c-primary));
    color: var(--text-dim);
  }
</style>
