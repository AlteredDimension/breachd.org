---
import Layout from "../../layouts/Layout.astro";
import BlogCarousel from "../../components/react/BlogCarousel.jsx";
import { posts, TAGS } from "../../data/posts.js";
---

<Layout title="blog — breach:d" description="Write-ups, anecdotes, and signal from the field.">
  <section class="blog-page shell">
    <header class="blog-head">
      <p class="eyebrow">// the feed</p>
      <h1 class="page-title">Blog</h1>
    </header>
    <BlogCarousel client:visible posts={posts} tags={TAGS} />
  </section>
</Layout>

<style>
  /* carousel as the centerpiece — fits the viewport, no scroll needed */
  .blog-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: var(--nav-h);
    padding-bottom: 2rem;
  }
  .blog-head {
    text-align: center;
    margin-bottom: 1.4rem;
  }
  .blog-head .eyebrow {
    margin-bottom: 0.4rem;
  }
  .page-title {
    margin: 0;
  }
</style>
